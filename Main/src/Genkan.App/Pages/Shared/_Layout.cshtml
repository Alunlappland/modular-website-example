@inject Genkan.Theme.ThemeService ThemeService
@{
    var theme = Context.Request.Cookies["genkan.theme"] ?? "surface";
    if (theme is not ("surface" or "inner" or "neutral")) theme = "surface";

    var authed = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("admin");
    var display = User.FindFirst("display")?.Value ?? (authed ? User.Identity!.Name : "访客");
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "guest";
    var here = Context.Request.Path.Value ?? "/";
    var encodedHere = Uri.EscapeDataString(here);

    string Active(string path) =>
        path == "/"
            ? (here == "/" ? "is-active" : "")
            : (here.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "is-active" : "");

    var items = new (string Path, string Label, string Glyph)[]
    {
        ("/", "玄关", "⌂"),
        ("/ai", "对话", "✳"),
        ("/blog", "博客", "✎"),
        ("/files", "文件", "⇅"),
        ("/about", "关于", "☾"),
    };

    var soonItems = Array.Empty<(string Label, string Glyph)>();

    var themeSettings = ThemeService.Load();
    // 背景图只给站长本人看：访客和普通成员的页面一律不挂图
    var hasBackground = ThemeService.HasBackground && authed && isAdmin;
    var effects = theme == "inner" && themeSettings.Effects;
    var bgStyle = hasBackground ? $"--bg-image:url('/theme/background?v={ThemeService.BackgroundVersion}')" : string.Empty;

    // 之前用内网地址直连过、这次是从隧道进来的 → 给个「试试直连」的按钮，不自动跳
    var directOrigin = Genkan.Network.DirectLinkMiddleware.IsTunnel(Context.Request)
        ? Genkan.Network.DirectLinkMiddleware.ReadOrigin(Context.Request)
        : null;
    var directUrl = directOrigin is null ? null : directOrigin + Context.Request.Path + Context.Request.QueryString;
}
<!doctype html>
<html lang="zh-CN" data-theme="@theme" data-fx="@(effects ? "on" : "off")" data-font="@themeSettings.Font" data-bg="@(themeSettings.InsetBackground ? "inset" : "full")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · 情绪流形的小屋</title>
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/css/base.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="app @(hasBackground ? "has-bg" : "")" data-role="@role" style="@bgStyle">
    @if (authed && User.IsInRole("viewer"))
    {
        <div class="direct-hint" style="border-color: var(--line); background: color-mix(in srgb, var(--ink) 5%, transparent);">
            <span>当前是只读账号：可以浏览，上传/保存/删除等操作会被拒绝。</span>
        </div>
    }

    @if (directUrl is not null)
    {
        <div class="direct-hint">
            <span>这次走的是隧道。你之前直连访问过，切到内网地址会快很多。</span>
            <a class="direct-hint-go" href="@directUrl">试试直连</a>
            <a class="direct-hint-skip" href="/direct/forget?returnUrl=@Uri.EscapeDataString(here)">忽略</a>
        </div>
    }
    <header class="mtop">
        <a class="mtop-brand" href="/">
            <img src="/assets/logo.svg" alt="" width="22" height="22" />
            <span>玄关</span>
        </a>
        <div class="mtop-right">
            @if (authed)
            {
                <a class="who" href="/me">@display</a>
            }
            else
            {
                <a class="who" href="/login">登录</a>
            }
        </div>
    </header>

    <div class="shell">
        <main class="content">
            @RenderBody()
        </main>

        <aside class="snav" aria-label="主导航">
            <div class="snav-top">
                <span class="snav-brand">情绪流形的小屋</span>
                <span class="snav-sub">玄关 · GENKAN</span>
            </div>

            <nav class="snav-links">
                @foreach (var item in items)
                {
                    <a class="snav-link @Active(item.Path)" href="@item.Path">
                        <span class="glyph">@item.Glyph</span><span>@item.Label</span>
                    </a>
                }
                @foreach (var item in soonItems)
                {
                    <span class="snav-link is-soon" title="装修中">
                        <span class="glyph">@item.Glyph</span><span>@item.Label</span>
                    </span>
                }
                @if (authed)
                {
                    <a class="snav-link @Active("/dashboard")" href="/dashboard">
                        <span class="glyph">▤</span><span>仪表盘</span>
                    </a>
                    <a class="snav-link @Active("/sync")" href="/sync">
                        <span class="glyph">⇄</span><span>同步</span>
                    </a>
                    <a class="snav-link @Active("/console")" href="/console">
                        <span class="glyph">⌘</span><span>命令提示</span>
                    </a>
                    <a class="snav-link @Active("/gallery")" href="/gallery">
                        <span class="glyph">▦</span><span>图墙</span>
                    </a>
                    <a class="snav-link @Active("/notes")" href="/notes">
                        <span class="glyph">▤</span><span>笔记</span>
                    </a>
                    <a class="snav-link @Active("/clip")" href="/clip">
                        <span class="glyph">⧉</span><span>剪贴板</span>
                    </a>
                }
                @if (isAdmin)
                {
                    <a class="snav-link @Active("/admin/routes")" href="/admin/routes">
                        <span class="glyph">⚙</span><span>路由管理</span>
                    </a>
                    <a class="snav-link @(here.StartsWith("/admin/users", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/admin/users">
                        <span class="glyph">☰</span><span>账号管理</span>
                    </a>
                    <a class="snav-link @Active("/steward")" href="/steward">
                        <span class="glyph">✧</span><span>代理站长</span>
                    </a>
                    <a class="snav-link @Active("/backup")" href="/backup">
                        <span class="glyph">⛁</span><span>备份</span>
                    </a>
                    <a class="snav-link @Active("/diagnostics")" href="/diagnostics">
                        <span class="glyph">✚</span><span>自诊断</span>
                    </a>
                }
            </nav>

            <div class="snav-bottom">
                <div class="theme-switch" title="表 / 里 / 中性">
                    <a class="@(theme == "surface" ? "on" : "")" href="/theme?name=surface&returnUrl=@encodedHere">表</a>
                    <a class="@(theme == "inner" ? "on" : "")" href="/theme?name=inner&returnUrl=@encodedHere">里</a>
                    <a class="@(theme == "neutral" ? "on" : "")" href="/theme?name=neutral&returnUrl=@encodedHere">中</a>
                </div>
                <div class="snav-user">
                    @if (authed)
                    {
                        <a href="/me">@display</a>
                    }
                    else
                    {
                        <a href="/login">登录</a>
                    }
                </div>
            </div>
        </aside>
    </div>

    <nav class="mbottom" aria-label="底部导航">
        @foreach (var item in items)
        {
            <a class="mbottom-link @Active(item.Path)" href="@item.Path">
                <span class="glyph">@item.Glyph</span><span>@item.Label</span>
            </a>
        }
        <button class="mbottom-link" type="button" id="more-toggle" aria-haspopup="true" aria-expanded="false">
            <span class="glyph">⋯</span><span>更多</span>
        </button>
    </nav>

    <div class="mdrawer" id="mdrawer" hidden>
        <div class="mdrawer-backdrop" id="mdrawer-backdrop"></div>
        <div class="mdrawer-panel" role="dialog" aria-label="更多页面">
            <div class="mdrawer-head">
                <span>更多</span>
                <button class="link" type="button" id="more-close">关闭</button>
            </div>

            <div class="mdrawer-grid">
                @if (authed)
                {
                    <a href="/dashboard">仪表盘</a>
                    <a href="/sync">同步</a>
                    <a href="/console">命令提示</a>
                    <a href="/gallery">图墙</a>
                    <a href="/notes">笔记</a>
                    <a href="/clip">剪贴板</a>
                }
                @if (isAdmin)
                {
                    <a href="/admin/routes">路由管理</a>
                    <a href="/admin/users">账号管理</a>
                    <a href="/steward">代理站长</a>
                    <a href="/backup">备份</a>
                    <a href="/diagnostics">自诊断</a>
                }
                <a href="/about">关于</a>
                @if (authed)
                {
                    <a href="/me">我的</a>
                }
                else
                {
                    <a href="/login">登录</a>
                }
            </div>

            <div class="mdrawer-foot">
                <div class="theme-switch" title="表 / 里 / 中性">
                    <a class="@(theme == "surface" ? "on" : "")" href="/theme?name=surface&returnUrl=@encodedHere">表</a>
                    <a class="@(theme == "inner" ? "on" : "")" href="/theme?name=inner&returnUrl=@encodedHere">里</a>
                    <a class="@(theme == "neutral" ? "on" : "")" href="/theme?name=neutral&returnUrl=@encodedHere">中</a>
                </div>
                @if (authed)
                {
                    <form method="post" asp-page="/Logout">
                        <button class="link" type="submit">退出登录</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <script src="/assets/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
