@page "/d/{token}"
@model Genkan.Pages.DropModel
@{
    ViewData["Title"] = "收件箱";
}
<link rel="stylesheet" href="/assets/css/files.css" asp-append-version="true" />

<section class="panel share-page">
    <p class="eyebrow">DROP BOX</p>
    <h1>投递文件</h1>
    <p class="muted">这个链接只能上传，看不到别人的文件。单文件最大 512MB。</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="notice">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert">@Model.Error</div>
    }

    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
        @if (Model.NeedPassword)
        {
            <label class="field">
                <span>提取码</span>
                <input asp-for="Password" autocomplete="off" />
            </label>
        }
        <label class="field">
            <span>选择文件</span>
            <input type="file" name="Upload" />
        </label>
        <button class="btn" type="submit">上传</button>
    </form>
</section>
