@page "/gallery"
@model Genkan.Pages.GalleryModel
@{
    ViewData["Title"] = "图墙";
}
<link rel="stylesheet" href="/assets/css/gallery.css" asp-append-version="true" />

<section class="gallery-page" id="gallery"
         data-tags="@Model.Tags" data-provider="@Model.Provider"
         data-source="@Model.Source" data-view="@Model.View">
    <header class="gallery-head">
        <div>
            <p class="eyebrow">GALLERY</p>
            <h1>图墙</h1>
            <p class="muted small">只从 SFW 图源拉取（@Model.ProviderLabel · @Model.Tags）。往下滚会自动加载。</p>
        </div>
        <form method="get" class="gallery-search">
            <input type="hidden" name="source" value="@Model.Source" />
            <input name="tags" value="@Model.Tags" placeholder="标签，比如 landscape / 风景" autocomplete="off" />
            <button class="btn" type="submit">换一批</button>
        </form>
    </header>

    <div class="gallery-sources">
        @foreach (var source in Model.Sources)
        {
            <a class="chip @(Model.Source == source.Id ? "on" : "")"
               href="/gallery?source=@source.Id&tags=@Uri.EscapeDataString(Model.Tags)">@source.Label</a>
        }
        <span class="gallery-split"></span>
        <a class="chip @(Model.View == "all" ? "on" : "")" href="/gallery?source=@Model.Source&tags=@Uri.EscapeDataString(Model.Tags)">全部</a>
        <a class="chip @(Model.View == "favorites" ? "on" : "")" href="/gallery?source=@Model.Source&view=favorites">♥ 收藏</a>
    </div>

    <div class="gallery-blocked" id="gallery-blocked" hidden>
        <span class="muted small">已屏蔽：</span>
        <span class="gallery-blocked-list" id="gallery-blocked-list"></span>
    </div>

    <div class="gallery-history" id="gallery-history" hidden>
        <span class="muted small">搜过：</span>
        <span class="gallery-history-list" id="gallery-history-list"></span>
    </div>

    <div class="gallery-flow" id="gallery-flow"></div>

    <p class="muted small gallery-status" id="gallery-status">准备加载…</p>
    <div class="gallery-sentinel" id="gallery-sentinel" aria-hidden="true"></div>
</section>

<div class="gallery-lightbox" id="gallery-lightbox" hidden>
    <button class="gallery-close" type="button" id="gallery-close" aria-label="关闭">×</button>
    <img id="gallery-large" alt="" />
    <div class="gallery-caption" id="gallery-caption"></div>
    <div class="gallery-lightbox-actions">
        <button class="btn ghost" type="button" id="gallery-lightbox-fav">♥ 收藏</button>
        <a class="btn ghost" id="gallery-lightbox-open" target="_blank" rel="noreferrer">在源站打开</a>
    </div>
</div>

<script src="/assets/js/gallery.js" asp-append-version="true"></script>
