@page "/backup"
@model Genkan.Pages.BackupModel
@{
    ViewData["Title"] = "备份";
    if (Model.Busy)
    {
        // 后台任务进行中：每 10 秒自动刷新一次
        HttpContext.Response.Headers["Refresh"] = "10";
    }
}
<link rel="stylesheet" href="/assets/css/admin.css" asp-append-version="true" />

<section class="admin">
    <header class="admin-head">
        <div>
            <p class="eyebrow">BACKUP · kopia</p>
            <h1>自动备份</h1>
        </div>
        <p class="admin-hint">
            每天 @Model.DailyTime.ToString(@"hh\:mm") 增量快照；距上次全量满 @Model.FullEveryDays 天时打 full 标签。
            仓库密码用 DataProtection 加密保存在 conf 下。
        </p>
    </header>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="notice">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert">@Model.Error</div>
    }

    @if (Model.Busy)
    {
        <div class="notice">备份进行中，本页每 10 秒自动刷新。</div>
    }

    <section class="admin-form" style="margin-bottom:16px">
        <h2>状态</h2>
        <dl class="kv">
            <div>
                <dt>就绪</dt>
                <dd><span class="tag @(Model.Ready ? "on" : "off")">@Model.StatusSummary</span></dd>
            </div>
            <div><dt>kopia.exe</dt><dd><code>@Model.ExePath</code> @(Model.ExeExists ? "✓" : "✗")</dd></div>
            <div><dt>仓库配置</dt><dd><code>@Model.ConfigPath</code> @(Model.ConfigExists ? "✓" : "✗")</dd></div>
            <div><dt>仓库密码</dt><dd>@(Model.HasPassword ? "已保存（加密）" : "未保存")</dd></div>
            <div><dt>备份源</dt><dd>@Model.Sources.Count 个目录</dd></div>
            <div><dt>距上次全量</dt><dd>@(Model.DaysSinceFull == int.MaxValue ? "还没有全量备份" : Model.DaysSinceFull + " 天")</dd></div>
        </dl>

        @if (Model.Sources.Count > 0)
        {
            <ul class="backup-sources">
                @foreach (var source in Model.Sources)
                {
                    <li><code>@source</code></li>
                }
            </ul>
        }
    </section>

    <section class="admin-form" style="margin-bottom:16px">
        <h2>仓库密码</h2>
        <p class="muted small">只写不读：保存后不会在页面上显示，只能覆盖或清除。</p>
        <form method="post" asp-page-handler="Password">
            <div class="grid2">
                <label class="field">
                    <span>kopia 仓库密码</span>
                    <input asp-for="Password" type="password" autocomplete="new-password" />
                </label>
            </div>
            <button class="btn" type="submit">保存密码</button>
        </form>
        @if (Model.HasPassword)
        {
            <form method="post" asp-page-handler="Forget" style="margin-top:8px">
                <button class="btn ghost" type="submit">清除已保存的密码</button>
            </form>
        }
    </section>

    <section class="admin-form" style="margin-bottom:16px">
        <h2>立即备份</h2>
        <div class="row">
            <form method="post" asp-page-handler="Run">
                <input type="hidden" name="kind" value="daily" />
                <button class="btn" type="submit">增量快照</button>
            </form>
            <form method="post" asp-page-handler="Run">
                <input type="hidden" name="kind" value="full" />
                <button class="btn ghost" type="submit">全量恢复点（打 full 标签）</button>
            </form>
        </div>
        <p class="muted small">备份在后台执行，页面会等它跑完；大目录可能慢。</p>
    </section>

    <section class="admin-form" style="margin-bottom:16px">
        <h2>快照</h2>
        @if (Model.Snapshots.Count == 0)
        {
            <p class="muted">还没有快照（或者还没配置好仓库）。</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr><th>时间</th><th>来源</th><th>文件</th><th>大小</th><th>标签</th><th>ID</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var snapshot in Model.Snapshots)
                        {
                            <tr>
                                <td>@(DateTimeOffset.TryParse(snapshot.StartTime, out var at) ? at.ToLocalTime().ToString("MM-dd HH:mm") : snapshot.StartTime)</td>
                                <td class="snapshot-source" title="@snapshot.Source">@snapshot.Source</td>
                                <td>@snapshot.Files</td>
                                <td>@Genkan.Backup.BackupService.FormatBytes(snapshot.Bytes)</td>
                                <td>@snapshot.Tags</td>
                                <td><code data-snapshot="@snapshot.Id">@snapshot.Id</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <form method="post" asp-page-handler="Restore">
            <div class="grid2">
                <label class="field">
                    <span>恢复到 staging（填快照 ID）</span>
                    <input asp-for="SnapshotId" placeholder="kopia 快照 ID" />
                </label>
            </div>
            <button class="btn ghost" type="submit">恢复到这个目录</button>
            <p class="muted small">目标：<code>@Model.StagingPath</code>（绝不覆盖线上目录，确认后再手动合并）。</p>
        </form>
    </section>

    <section class="admin-form" style="margin-bottom:16px">
        <h2>网盘镜像（Cloudflare R2）</h2>
        <dl class="kv">
            <div><dt>状态</dt><dd><span class="tag @(Model.CloudReady ? "on" : "off")">@Model.CloudStatus</span></dd></div>
            <div><dt>端点</dt><dd><code>@Model.CloudEndpoint</code></dd></div>
            <div><dt>桶</dt><dd><code>@Model.CloudBucket</code></dd></div>
            <div><dt>目标</dt><dd><code>@Model.CloudTarget</code></dd></div>
        </dl>

        <p class="muted small">
            每天备份成功后会按配置自动镜像；手动镜像走下面。
            命令带 <code>--max-delete 50</code> 保险丝：本地仓库异常变空时最多删云端 50 个文件就停。
        </p>

        @if (Model.CloudMirroring)
        {
            <div class="notice">镜像进行中…</div>
        }

        <form method="post" asp-page-handler="R2Save">
            <div class="grid2">
                <label class="field">
                    <span>Access Key ID</span>
                    <input asp-for="R2AccessKeyId" autocomplete="off" />
                </label>
                <label class="field">
                    <span>Secret Access Key</span>
                    <input asp-for="R2SecretKey" type="password" autocomplete="new-password" />
                </label>
            </div>
            <button class="btn" type="submit">保存凭据</button>
        </form>

        @if (Model.CloudHasCredentials)
        {
            <form method="post" asp-page-handler="R2Clear" style="margin-top:8px">
                <button class="btn ghost" type="submit">清除凭据</button>
            </form>
        }

        <div class="row">
            <form method="post" asp-page-handler="R2Test">
                <button class="btn ghost" type="submit">测试连接</button>
            </form>
            <form method="post" asp-page-handler="R2Mirror" onsubmit="return confirm('开始镜像到 R2？');">
                <button class="btn" type="submit">立即镜像</button>
            </form>
        </div>

        <p class="muted small">
            凭据需要 R2 的 <b>Object Read &amp; Write</b> 权限；创建位置：Cloudflare → R2 → Manage R2 API Tokens。
        </p>
    </section>

    <section class="admin-form" style="margin-bottom:16px">
        <h2>保留策略</h2>
        @if (Model.Retention is null)
        {
            <p class="muted">还没有快照。</p>
        }
        else
        {
            <p class="muted small">
                保留最近 6 个 full 恢复点 + 最近 10 天的日快照；其余列在下面。
                确认后可一键清理（会在历史里留一条 retention 记录）。
            </p>
            <dl class="kv">
                <div><dt>保留</dt><dd>@Model.Retention.Keep.Count 个</dd></div>
                <div><dt>可清理</dt><dd>@Model.Retention.Expire.Count 个</dd></div>
            </dl>
            @if (Model.Retention.Expire.Count > 0)
            {
                <ul class="backup-sources">
                    @foreach (var snapshot in Model.Retention.Expire.Take(10))
                    {
                        <li><code>@snapshot.Id</code> · @snapshot.StartTime</li>
                    }
                </ul>
                <form method="post" asp-page-handler="Retention" onsubmit="return confirm('删除 @Model.Retention.Expire.Count 个旧快照？此操作不可恢复。');">
                    <button class="btn ghost" type="submit">清理这些旧快照</button>
                </form>
            }
        }
    </section>

    <section class="admin-form" style="margin-bottom:16px">
        <h2>恢复包</h2>
        <p class="muted small">把仓库路径、kopia 配置、密码和恢复步骤导出成一个 Markdown 文件（**含明文密码**）。</p>
        <form method="post" asp-page-handler="ExportKit" onsubmit="return confirm('恢复包里有明文密码，确认导出？');">
            <button class="btn ghost" type="submit">导出恢复包</button>
        </form>
    </section>

    <section class="admin-form">
        <h2>历史</h2>
        @if (Model.Runs.Count == 0)
        {
            <p class="muted">还没有执行记录。</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr><th>时间</th><th>类型</th><th>结果</th><th>文件</th><th>大小</th><th>备注</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Model.Runs)
                        {
                            <tr>
                                <td>@(DateTimeOffset.TryParse(run.StartedAt, out var at) ? at.ToLocalTime().ToString("MM-dd HH:mm") : run.StartedAt)</td>
                                <td>@run.Kind</td>
                                <td><span class="tag @(run.State == "success" ? "on" : "off")">@run.State</span></td>
                                <td>@(run.Files?.ToString() ?? "—")</td>
                                <td>@(run.Bytes is null ? "—" : Genkan.Backup.BackupService.FormatBytes(run.Bytes.Value))</td>
                                <td class="run-error" title="@run.Error">@(run.Error ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
